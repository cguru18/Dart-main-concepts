<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.studentmanagement.controller.StudentDashboardController">
   <top>
      <!-- Navigation Bar -->
      <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="nav-bar">
         <Label styleClass="nav-title" text="Student Dashboard" />
         <Region HBox.hgrow="ALWAYS" />
         <VBox alignment="CENTER_RIGHT" spacing="2.0">
            <Label fx:id="welcomeLabel" styleClass="nav-user-info" text="Welcome, Student" />
            <Label fx:id="admissionLabel" styleClass="nav-user-info" text="Admission: STD001" />
         </VBox>
      </HBox>
   </top>

   <left>
      <!-- Sidebar Navigation -->
      <VBox fx:id="sidebar" spacing="5.0" styleClass="sidebar">
         <Button fx:id="profileButton" maxWidth="Infinity" styleClass="sidebar-item" text="📊 Profile &amp; Subjects" />
         <Button fx:id="subjectsButton" maxWidth="Infinity" styleClass="sidebar-item" text="📚 My Subjects" />
         <Button fx:id="examsButton" maxWidth="Infinity" styleClass="sidebar-item" text="📝 Exam Results" />
         <Button fx:id="reportsButton" maxWidth="Infinity" styleClass="sidebar-item" text="📄 Generate Report" />
         
         <Region VBox.vgrow="ALWAYS" />
         
         <Separator />
         <Button fx:id="logoutButton" maxWidth="Infinity" styleClass="sidebar-item" text="🚪 Logout" />
      </VBox>
   </left>

   <center>
      <!-- Main Content Area -->
      <StackPane fx:id="contentArea" styleClass="content-area">
         
         <!-- Profile Section -->
         <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox fx:id="profileSection" spacing="25.0">
               
               <!-- Profile Header -->
               <VBox alignment="CENTER" spacing="15.0" styleClass="profile-header">
                  <Label fx:id="profileNameLabel" styleClass="profile-name" text="Student Name" />
                  <HBox alignment="CENTER" spacing="20.0">
                     <Label fx:id="profileEmailLabel" styleClass="profile-admission" text="student@email.com" />
                     <Label fx:id="profileAdmissionLabel" styleClass="profile-admission" text="STD001234" />
                  </HBox>
               </VBox>

               <!-- Statistics Cards -->
               <GridPane hgap="20.0" vgap="20.0" styleClass="grid-container">
                  <columnConstraints>
                     <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                     <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                     <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                     <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                  </columnConstraints>
                  
                  <VBox alignment="CENTER" spacing="10.0" styleClass="stats-card" GridPane.columnIndex="0">
                     <Label fx:id="totalSubjectsLabel" styleClass="stats-number" text="0" />
                     <Label styleClass="stats-label" text="Total Subjects" />
                  </VBox>
                  
                  <VBox alignment="CENTER" spacing="10.0" styleClass="stats-card" GridPane.columnIndex="1">
                     <Label fx:id="averageMarksLabel" styleClass="stats-number" text="0%" />
                     <Label styleClass="stats-label" text="Average Marks" />
                  </VBox>
                  
                  <VBox alignment="CENTER" spacing="10.0" styleClass="stats-card" GridPane.columnIndex="2">
                     <Label fx:id="overallGradeLabel" styleClass="stats-number" text="N/A" />
                     <Label styleClass="stats-label" text="Overall Grade" />
                  </VBox>
                  
                  <VBox alignment="CENTER" spacing="10.0" styleClass="stats-card" GridPane.columnIndex="3">
                     <Label fx:id="totalExamsLabel" styleClass="stats-number" text="0" />
                     <Label styleClass="stats-label" text="Total Exams" />
                  </VBox>
               </GridPane>

               <!-- Subject Selection Section -->
               <VBox spacing="20.0" styleClass="card">
                  <VBox spacing="10.0" styleClass="card-header">
                     <Label styleClass="card-title-white" text="Subject Selection" />
                     <Label styleClass="card-title-white" text="Choose your elective subjects (7-8 total subjects required)" />
                  </VBox>
                  
                  <VBox spacing="15.0">
                     <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxHeight="400.0" vbarPolicy="AS_NEEDED">
                        <GridPane fx:id="subjectSelectionGrid" hgap="15.0" vgap="10.0" styleClass="subject-grid">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </GridPane>
                     </ScrollPane>
                     
                     <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <Label fx:id="subjectCountLabel" styleClass="info-message" text="Selected: 3/8 subjects" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="saveSubjectsButton" styleClass="primary-button" text="Save Subject Selection" />
                     </HBox>
                  </VBox>
               </VBox>
            </VBox>
         </ScrollPane>

         <!-- Exam Results Section -->
         <VBox fx:id="examSection" spacing="25.0" visible="false">
            
            <!-- Exam Results Header -->
            <VBox spacing="10.0" styleClass="card-header">
               <Label styleClass="card-title-white" text="Examination Results" />
               <Label styleClass="card-title-white" text="View your performance across all subjects" />
            </VBox>

            <!-- Exam Results Table -->
            <VBox spacing="15.0" styleClass="card">
               <TableView fx:id="examResultsTable" styleClass="table-view">
                  <columns>
                     <TableColumn fx:id="subjectColumn" prefWidth="120.0" text="Subject" />
                     <TableColumn fx:id="examNameColumn" prefWidth="150.0" text="Exam Name" />
                     <TableColumn fx:id="examTypeColumn" prefWidth="130.0" text="Exam Type" />
                     <TableColumn fx:id="marksColumn" prefWidth="80.0" text="Marks" />
                     <TableColumn fx:id="gradeColumn" prefWidth="60.0" text="Grade" />
                     <TableColumn fx:id="positionColumn" prefWidth="80.0" text="Position" />
                     <TableColumn fx:id="dateColumn" prefWidth="100.0" text="Date" />
                  </columns>
               </TableView>
               
               <!-- Report Generation -->
               <HBox alignment="CENTER_LEFT" spacing="20.0">
                  <Button fx:id="generateReportButton" styleClass="primary-button" text="Generate PDF Report" />
                  <ProgressIndicator fx:id="reportProgress" maxHeight="25.0" maxWidth="25.0" visible="false" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label styleClass="info-message" text="Generate a comprehensive performance report" />
               </HBox>
            </VBox>
         </VBox>

      </StackPane>
   </center>
</BorderPane>